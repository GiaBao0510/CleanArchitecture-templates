APP_ENV=local

HTTP_ADDRESS=:8080
GRPC_ADDRESS=:50051

DB_DRIVER=postgres
DB_DSN=postgres://app:app_password@localhost:5432/appdb?sslmode=disable

REDIS_ADDRESS=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=5m

KAFKA_BROKERS=localhost:9092,localhost:9093
KAFKA_USER_TOPIC=user.events
KAFKA_WORKER_GROUP_ID=user-worker-group
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

LOG_LEVEL=debug
LOG_FORMAT=text